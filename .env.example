# Environment variables configuration for Controle de Estoque & CMV

# Server configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Optional - in-memory mock is used when not configured)
# PostgreSQL example: postgresql://username:password@hostname:5432/database_name?sslmode=require
# MySQL example: mysql://username:password@hostname:3306/database_name
DATABASE_URL=

# Gemini API Key (Server-side AI features)
GEMINI_API_KEY=

# ReceitaWS API Token (Optional commercial token for higher query limits)
RECEITAWS_TOKEN=
